<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>لوحة المطور السرية</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@700&display=swap');
*{font-family:'Cairo',sans-serif;box-sizing:border-box}body{background:#000;color:#fff;padding:18px;min-height:100vh}
.bg{position:fixed;inset:0;background:url('bg1.jpg') center/cover;filter:brightness(0.3);z-index:-1}
h1{text-align:center;color:#c084fc} .card{background:rgba(255,255,255,0.06);border:1px solid rgba(168,85,247,0.3);border-radius:16px;padding:14px;margin:14px 0;backdrop-filter:blur(12px)}
button{width:100%;padding:12px;border:none;border-radius:12px;background:linear-gradient(135deg,#8b5cf6,#ec4899);color:#fff;font-weight:900;cursor:pointer;margin-top:8px}
.code{background:rgba(0,0,0,0.6);padding:8px;border-radius:8px;margin:6px 0;border:1px dashed #a855f7;display:flex;justify-content:space-between;font-family:monospace}
</style>
</head><body>
<div class="bg"></div>
<h1>꧁ لوحة تحكم المطور السرية ꧂</h1>
<p style="text-align:center;color:#9ca3af;font-size:11px">ADMIN ONLY • X7Y9-Z3K8-M2P4-Q5R1</p>
<div class="card"><h3>🔑 توليد كود جديد</h3><button onclick="gen()">+ توليد كود عالمي</button><div id="new"></div></div>
<div class="card"><h3>📋 الأكواد النشطة</h3><div id="active"></div></div>
<div class="card"><h3>🔥 الأكواد المحروقة</h3><div id="used"></div><button onclick="localStorage.removeItem('ghost_used_codes');load();" style="background:#1f2937">حذف المحروقة</button></div>
<script>
function load(){let valid=JSON.parse(localStorage.getItem('ghost_valid_codes')||'[]'); let used=JSON.parse(localStorage.getItem('ghost_used_codes')||'{}'); document.getElementById('active').innerHTML=valid.filter(c=>!used[c]).map(c=>'<div class=code><span>'+c+'</span><button style=width:auto;padding:2px 8px;font-size:11px onclick=navigator.clipboard.writeText("'+c+'")>نسخ</button></div>').join('')||'لا يوجد'; document.getElementById('used').innerHTML=Object.keys(used).map(c=>'<div class=code>'+c+' 🔥 '+used[c]+'</div>').join('')||'لا يوجد';}
function gen(){let code='GHOST-'+Math.random().toString(36).substr(2,4).toUpperCase()+'-'+Math.random().toString(36).substr(2,4).toUpperCase()+'-'+Date.now().toString(36).toUpperCase().slice(-3); let valid=JSON.parse(localStorage.getItem('ghost_valid_codes')||'[]'); valid.push(code); localStorage.setItem('ghost_valid_codes',JSON.stringify(valid)); document.getElementById('new').innerHTML='<div class=code style=color:#86efac>'+code+'</div>'; load();}
load();
</script>
</body></html>
